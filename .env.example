# monitor-core's PUBLIC origin. Baked into the browser bundle because the SSO
# "Continue with <provider>" button is a full-page redirect the browser makes
# directly to the backend (${NEXT_PUBLIC_MONITOR_API_URL}/auth/sso/{slug}/login),
# and the server-side /api/monitor proxy also uses it as its upstream. This is the
# monitor-core API, NOT the Next.js app's own origin.
NEXT_PUBLIC_MONITOR_API_URL=http://localhost:8080

# Server-side ingest/admin API key for monitor-core (never sent to the browser)
MONITOR_API_KEY=your-secret-key

# The CONTROL PLANE's monitor-core, over the container network. Preferred by the
# proxy over NEXT_PUBLIC_MONITOR_API_URL so a request never hairpins out to the
# public domain and back. Server-only; never bundled.
MONITOR_API_INTERNAL_URL=http://monitor-core:8080

# The zone this deployment's own monitor-core ALSO serves (it runs MON_ROLE=both).
# Requests for this zone take the internal address above instead of its registered
# query_url — which keeps the hop on the container network AND is what keeps the
# zone working while its registry row still has no query_url recorded.
#
# Set it to "" on a pure MON_ROLE=app control plane that serves no zone data.
# Every OTHER zone must have a query_url in the registry (Admin -> Registry) or
# its pages return 502 zone_unroutable — by design, so a misrouted request is
# refused rather than answered from the wrong zone.
MON_LOCAL_ZONE=trailblaze

# Font Awesome kit npm token — referenced by .npmrc as ${NPM_TOKEN} so it is never
# committed. Required for `npm install`/`npm ci` to fetch the private FA kit. CI
# provides the same value from Keyring as NPM_TOKEN, so keep this name in sync.
NPM_TOKEN=your-fontawesome-npm-token

# ─── Self-telemetry (this app's OWN errors → the appleby Monitor zone) ────────
#
# Unset URL or key = telemetry off, and the app runs normally. Read from PLAIN
# ENV, never Keyring: Keyring cannot supply the telemetry config of the service
# that depends on it, and instrumentation.ts reads these before injectEnv runs.
#
# ⚠️ MON_TELEMETRY_*, not MONITOR_API_KEY — that name is already monitor-core's
# ingest master key on this stack, and reusing it would collide.
#
# The key is server-only: the browser posts to the same-origin /api/telemetry
# relay, which attaches it. Never expose it as NEXT_PUBLIC_*.
#
# In Lattice these interpolate from the globals (see AGENTS.md §6):
#   MON_TELEMETRY_INGEST_URL=${MONITOR_APPLEBY_INGEST_URL}
#   MON_TELEMETRY_API_KEY=${MONITOR_APPLEBY_INGEST_KEY}
# MON_TELEMETRY_INGEST_URL=https://appleby-monitor-api.appleby.cloud/v1/events
# MON_TELEMETRY_API_KEY=an-ingest-scope-key-minted-on-the-appleby-zone

# `env` on reported events. Defaults to "production" when unset.
# MON_TELEMETRY_ENV=local

# Keyring (optional — if set, the values above are fetched from Keyring at server
# startup and override the ones here)
# KEYRING_URL=https://keyring.cloud
# KEYRING_ACCESS_KEY_ID=KR...
# KEYRING_SECRET_ACCESS_KEY=...
